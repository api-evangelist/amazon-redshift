          "name": "Amazon Redshift Get the Results of a Sql Statement",
          "request": {
            "name": "Amazon Redshift Get the Results of a Sql Statement",
            "description": {
              "content": "Fetches the result of a SQL statement that was submitted with ExecuteStatement or BatchExecuteStatement. The statement must have completed successfully (status FINISHED). Results are paginated and the maximum result size is 100 MB. Use the NextToken parameter to retrieve subsequent pages.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "GetStatementResult"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "description": "AWS region identifier (This can only be one of us-east-1,us-east-2,us-west-1,us-west-2,eu-west-1,eu-west-2,eu-central-1,ap-southeast-1,ap-southeast-2,ap-northeast-1,ap-northeast-2,ca-central-1,sa-east-1)",
                  "type": "any",
                  "value": "{{region}}",
                  "key": "region"
                }
              ]
