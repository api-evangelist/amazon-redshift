          "name": "Amazon Redshift Execute a Sql Statement",
          "request": {
            "name": "Amazon Redshift Execute a Sql Statement",
            "description": {
              "content": "Runs a SQL statement against an Amazon Redshift cluster or Amazon Redshift Serverless workgroup. The SQL statement runs asynchronously and returns a statement identifier that you can use to check the status with DescribeStatement and retrieve results with GetStatementResult. The maximum query result size is 100 MB.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "ExecuteStatement"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
