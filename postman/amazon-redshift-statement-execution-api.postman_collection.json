            "body": {
              "mode": "raw",
              "raw": "{\n  \"Database\": \"<string>\",\n  \"Sqls\": [\n    \"<string>\"\n  ],\n  \"ClusterIdentifier\": \"<string>\",\n  \"DbUser\": \"<string>\",\n  \"SecretArn\": \"<string>\",\n  \"StatementName\": \"<string>\",\n  \"WithEvent\": false,\n  \"WorkgroupName\": \"<string>\",\n  \"ClientToken\": \"<string>\"\n}",
              "options": {
